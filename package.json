    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "framer-motion": "12.43.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
